# Used by compose.yaml for the optional local PostgreSQL service.
AEDES_LOCAL_DB_PASSWORD=replace-with-a-local-only-password

# The API reads these from its process environment. If unset, it uses repo-root aedes.db.
# For PostgreSQL, set this in the API and worker PowerShell sessions after starting Compose.
# AEDES_DATABASE_URL=postgresql+psycopg://aedes_local:replace-with-a-local-only-password@localhost:5432/aedes
# Optional when the web UI uses a non-default origin.
# AEDES_WEB_ORIGIN=http://127.0.0.1:3000
# Set to 1 only when serving the local demo over HTTPS.
# AEDES_SECURE_COOKIES=0
