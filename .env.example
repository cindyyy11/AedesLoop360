# AedesLoop 360 — environment reference
# Copy keys you need into the API/worker shell, Compose, or the Railway dashboard.
# The API does not auto-load this file. Do not commit a real .env with secrets.

# --- Compose local Postgres (compose.yaml) ---
AEDES_LOCAL_DB_PASSWORD=replace-with-a-local-only-password

# --- Database ---
# Unset = repo-root aedes.db (SQLite). Railway Postgres plugin sets DATABASE_URL;
# services/api/app/db.py also accepts AEDES_DATABASE_URL and normalises postgres://.
# AEDES_DATABASE_URL=sqlite:///C:/Users/User/AedesLoop360/data/aedes-demo.sqlite
# AEDES_DATABASE_URL=postgresql+psycopg://aedes_local:replace-with-a-local-only-password@localhost:5432/aedes
# DATABASE_URL=  # injected by Railway; prefer leaving AEDES_DATABASE_URL unset there

# --- CORS / cookies ---
# AEDES_WEB_ORIGIN=http://127.0.0.1:3000
# Comma-separated extra origins (no spaces required).
# AEDES_WEB_ORIGINS=https://aedesloop360-web.vercel.app
# Allow any https://*.vercel.app preview origin (hosted demo).
# AEDES_ALLOW_VERCEL_APP_ORIGINS=1
# Set to 1 only behind HTTPS.
# AEDES_SECURE_COOKIES=0

# --- Lifecycle (API process) ---
# AEDES_AUTO_MIGRATE=1
# AEDES_SEED_DEMO=1

# --- Models (local: scripts/start-api.ps1; Railway image: /models/...) ---
# AEDES_DRONE_MODEL_PATH=/models/drone/best.pt
# AEDES_EGG_MODEL_PATH=/models/eggs/texture_ridge.joblib

# --- Live detection rate limit ---
# AEDES_LIVE_MAX_FRAMES_PER_5S=20
