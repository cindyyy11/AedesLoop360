# Web app env — copy to .env.local for local overrides (gitignored).
# next.config.ts rewrites /api/* -> AEDES_API_ORIGIN/api/*.

# --- Runtime ---
# Local API (default when unset).
AEDES_API_ORIGIN=http://127.0.0.1:8000
# Hosted Railway API:
# AEDES_API_ORIGIN=https://api-production-ffaa.up.railway.app

# --- Dev / build isolation (optional) ---
# Separate Next output dir when running a second server alongside the default.
# AEDES_NEXT_DIST_DIR=.next-side

# --- Playwright (optional; set in the test shell) ---
# AEDES_WEB_ORIGIN=http://127.0.0.1:3000
# AEDES_BROWSER_EXECUTABLE=C:/Users/User/AppData/Local/ms-playwright/chromium-1234/chrome-win64/chrome.exe
# AEDES_FAKE_CAMERA_MJPEG=path/to/drone-frames.mjpeg
# AEDES_FAKE_EGG_MJPEG=path/to/egg-paddle-frames.mjpeg
# AEDES_TEST_VIDEO=path/to/clip.webm
# AEDES_LIVE_3D_TEST=1

# Optional: lat,lng where the fictional township is overlaid on the real map (presentation only; keep non-residential).
# NEXT_PUBLIC_MAP_ANCHOR=1.2802,103.8715
