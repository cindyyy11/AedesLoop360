# Copy to deploy/.env.deploy (git-ignored). Never commit real values.
# Used by: docker compose --env-file deploy/.env.deploy -f compose.deploy.yaml up --build

# Required for Postgres in compose.deploy.yaml
AEDES_DB_PASSWORD=replace-with-a-strong-password

# Browser origin allowed by the API (match the web container URL).
AEDES_WEB_ORIGIN=http://localhost:3000

# Set to 1 only behind HTTPS before exposing beyond localhost.
AEDES_SECURE_COOKIES=0

# 1 = seed the fictional four-block demo after migrating (idempotent).
# Set 0 and provision real users before any shared deployment.
AEDES_SEED_DEMO=1

# Model paths inside the container (Compose mounts deploy/models at /models).
# Leave both empty / unset the overrides for fixture-only mode (uploads → NOT_CONFIGURED).
AEDES_DRONE_MODEL_PATH=/models/drone/best.pt
AEDES_EGG_MODEL_PATH=/models/eggs/texture_ridge.joblib
# Fixture-only example:
# AEDES_DRONE_MODEL_PATH=
# AEDES_EGG_MODEL_PATH=
