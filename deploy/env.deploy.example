# Copy to deploy/.env.deploy (git-ignored). Never commit real values.
AEDES_DB_PASSWORD=replace-with-a-strong-password
AEDES_WEB_ORIGIN=http://localhost:3000
# Set to 1 only behind HTTPS.
AEDES_SECURE_COOKIES=0
# 1 = seed the fictional four-block demo scenario after migrating (idempotent).
AEDES_SEED_DEMO=1
# Set these to empty strings to run without model weights (fixture-only mode).
# AEDES_DRONE_MODEL_PATH=/models/drone/best.pt
# AEDES_EGG_MODEL_PATH=/models/eggs/texture_ridge.joblib
